# Copy this file to .env and fill in real values before deploying.

PORT=3000
NODE_ENV=production

# Public URL of the deployed site (used to build Stripe success/cancel redirect links)
PUBLIC_BASE_URL=https://pbisb.com

# Long random string used to sign admin login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Only used the FIRST time the server starts (creates data/db.json).
# Change the password immediately from the admin dashboard after first login,
# or set these before first run.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=changeme123

# Stripe (test mode keys start with sk_test_ / whsec_ — switch to live keys when ready)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Payment Links (simple redirect mode — replaces full checkout session creation)
# Separate links for adult and kids membership types
STRIPE_PAYMENT_LINK_ADULT=https://buy.stripe.com/28EeVd2RL7vR7ID0WX6Ri00
STRIPE_PAYMENT_LINK_KIDS=https://buy.stripe.com/28E3cv8c55nJfb57ll6Ri01

# ----- Football-Data.org (FC Barcelona fixtures) -----
# Get a free key at https://www.football-data.org/client/register
# The key is read ONLY by the backend (src/services/fixture.service.js) and is
# never exposed to the browser. The scheduler caches fixtures in data/fixtures.json.
FOOTBALL_DATA_API_KEY=

# ----- Resend (transactional email for confirmations, receipts, OTP) -----
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender. MUST be a verified domain/email in Resend.
EMAIL_FROM=noreply@pbisb.com
EMAIL_FROM_NAME=Penya Blaugrana Islamabad

# ----- Web Push (sends a phone notification to the admin when a member chats) -----
# Generate once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# and paste the two keys below. VAPID_SUBJECT must be a mailto: link or site URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@pbisb.com